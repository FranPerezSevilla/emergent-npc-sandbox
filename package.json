{
  "name": "emergent-npc-sandbox",
  "version": "0.0.0",
  "private": true,
  "description": "Cloud-first PlayCanvas prototype for emergent NPC conversations",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/fake-inference-provider.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "playcanvas": "2.21.4"
  },
  "devDependencies": {
    "@playcanvas/eslint-config": "3.0.0-beta.8",
    "eslint": "9.39.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=22.23.2"
  }
}
